# --- Delphi / wallet (REQUIRED) ---
# Must be the SAME wallet address you registered on the DoraHacks competition page.
# Use a fresh keypair dedicated to the competition, not a personal wallet.
DELPHI_NETWORK=competition-testnet
DELPHI_SIGNER_TYPE=private_key
WALLET_PRIVATE_KEY=0xyour_registered_wallet_private_key_here

# Testnet API key for read operations (list markets/positions). Create one at
# https://delphi-api-access.gensyn.ai/ — MUST be a testnet key, a mainnet key
# returns 401 on every call against the competition.
DELPHI_API_ACCESS_KEY=your_api_key_here

# Optional: scope reads to one specific competition (UUID). Omit to use
# whichever competition Gensyn currently has flagged active.
# DELPHI_COMPETITION_ID=

# --- LLM for news/injury sanity-check (REQUIRED for newsSignal.ts) ---
# Groq: free tier, no credit card needed. Get a key at https://console.groq.com
GROQ_API_KEY=gsk_your-key-here
LLM_MODEL=llama-3.3-70b-versatile

# --- Optional: sports news API for injury/lineup context ---
# Not wired to a specific provider yet — see README "Plugging in news" section.
NEWS_API_KEY=

# --- Strategy tuning (all optional, sensible defaults in src/config.ts) ---
LONGSHOT_MIN_PRICE=0.05
LONGSHOT_MAX_PRICE=0.15
FAVORITE_MIN_PRICE=0.75
FAVORITE_MAX_PRICE=0.92
MIN_EDGE=0.1
MAX_POSITION_FRACTION=0.1
MAX_TOKENS_PER_TRADE=0
MAX_HOURS_TO_SETTLEMENT=240
POLL_INTERVAL_SECONDS=120
SLIPPAGE_BPS=300
